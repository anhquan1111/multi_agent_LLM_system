# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# IMPORTANT: never put a trailing comment on the same line as a value.
# Docker's --env-file parser does not strip them and the comment becomes part
# of the value, while python-dotenv locally does strip them. That difference
# makes the app work locally and crash inside the container.
#   BAD :  MAX_AGENT_STEPS=8   # loop cap
#   GOOD:  MAX_AGENT_STEPS=8

# --- Required ---
# Google AI Studio key (LLM + embeddings): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Models (verified against the live API on 13/08/2026 via scripts/check_key.py) ---
# NOTE: gemini-2.5-flash is still listed by models.list() but returns 404 on a real call.
# Always smoke-test a model before switching, not just list it.
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
# Native output is 3072 dims; truncated to 768 to keep the Chroma index small and fast.
# Changing this invalidates the whole index — you must re-run scripts/ingest.py.
EMBEDDING_DIM=768

# --- Guardrails ---
# Hard cap on supervisor routing loops
MAX_AGENT_STEPS=8
MAX_TOKENS_PER_REQUEST=8000
REQUEST_TIMEOUT_SECONDS=60

# --- Storage paths ---
CHROMA_DIR=data/chroma
SQLITE_PATH=data/shop.db
CHECKPOINT_PATH=checkpoints/graph.sqlite

# --- Tracing (optional; app runs fine without it) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-llm-system
